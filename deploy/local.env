# Fixed values for the local stack only: the public defaults of `supabase start` and throwaway
# local passwords. Nothing here works outside your machine. Never put real credentials in this file.
SUPABASE_DB_HOST=supabase_db_swimcro
SUPABASE_NETWORK=supabase_network_swimcro
SUPABASE_JWKS_URI=http://supabase_kong_swimcro:8000/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=postgres
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
POWERSYNC_DB_PASSWORD=local-powersync-only
POWERSYNC_STORAGE_PASSWORD=local-storage-only
# `supabase start` already loads supabase/seed.sql.
APPLY_SEED=false
# Required by compose.yaml for the Edge Functions delivery, which local mode does not run (compose.local.yaml gives it a
# profile nobody turns on). A placeholder so the file loads; nothing is ever mounted or written there.
SUPABASE_FUNCTIONS_DIR=/var/empty
