# Fixed values for the local stack only: the public defaults of `supabase start` and throwaway
# local passwords. Nothing here works outside your machine. Never put real credentials in this file.
SUPABASE_DB_HOST=supabase_db_trailskill
SUPABASE_NETWORK=supabase_network_trailskill
SUPABASE_JWKS_URI=http://supabase_kong_trailskill:8000/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=postgres
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
POWERSYNC_DB_PASSWORD=local-powersync-only
POWERSYNC_STORAGE_PASSWORD=local-storage-only
# `supabase start` already loads supabase/seed.sql.
APPLY_SEED=false
