#!/bin/sh
# Blocks direct pushes to main. GitHub Free cannot protect branches in private repositories.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct push to main is not allowed. Open a pull request (see CONTRIBUTING.md)." >&2
    exit 1
  fi
done
exit 0
