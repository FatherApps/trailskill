#!/bin/sh
# Blocks direct pushes to main (GitHub Free cannot protect branches in private repositories).
# For any other branch, brings origin/main into the branch with a merge (history is never rewritten) and
# stops the push so the merged result goes through the checks first. Tags and deletions pass untouched.
# A push with --no-verify skips this hook; .github/workflows/update-pr-branches.yml is the backup.
UPDATED="rama actualizada con main: corre los checks y vuelve a hacer push"
current=$(git symbolic-ref -q HEAD || true)
while read -r local_ref local_sha remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct push to main is not allowed. Open a pull request (see CONTRIBUTING.md)." >&2
    exit 1
  fi
  case "$local_ref" in refs/tags/*) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # all zeros: the push deletes the remote branch
  # Only the checked-out branch can be merged into; another ref passes and is covered by the workflow.
  [ "$local_ref" = "$current" ] || continue

  if ! git fetch -q origin main 2>/dev/null; then
    echo "pre-push: could not fetch origin/main (offline?); skipping the up-to-date check." >&2
    continue
  fi
  git merge-base --is-ancestor origin/main HEAD && continue

  if out=$(git merge --no-edit origin/main 2>&1); then
    echo "$UPDATED" >&2
    exit 1
  fi
  if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    conflicts=$(git diff --name-only --diff-filter=U)
    git merge --abort
    echo "pre-push: merging origin/main conflicts; the merge was aborted. Resolve these files by merging origin/main yourself:" >&2
    echo "$conflicts" | sed 's/^/  /' >&2
  else
    echo "pre-push: could not merge origin/main:" >&2
    echo "$out" >&2
  fi
  exit 1
done
exit 0
